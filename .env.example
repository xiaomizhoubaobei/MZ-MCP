# Huawei Cloud OCR Credentials
# Get these from: https://console.huaweicloud.com/iam/

# Access Key ID
CLOUD_SDK_AK=your_access_key_here

# Secret Access Key
CLOUD_SDK_SK=your_secret_key_here

# Project ID (required)
# Get from: https://console.huaweicloud.com/iam/#/projects
HUAWEI_OCR_PROJECT_ID=your_project_id_here

# OCR Service Region (optional, default: cn-east-3)
# Available regions: cn-north-1, cn-north-4, cn-east-2, cn-east-3, cn-south-1, etc.
HUAWEI_OCR_REGION=cn-east-3
